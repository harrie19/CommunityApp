generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id              String   @id @default(uuid())
  paypalId        String   @unique
  amount          Float
  currency        String
  shareArchitect  Float
  shareJustice    Float
  createdAt       DateTime @default(now())
}
